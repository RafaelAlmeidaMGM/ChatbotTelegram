# Crie o bot com @BotFather. Nunca publique ou envie o token em conversas.
TELEGRAM_BOT_TOKEN=
COMPANY_NAME=Atendimento
DATABASE_PATH=data/atendimento.sqlite3

# Grupo padrão da equipe (ID numérico; grupos normalmente usam IDs negativos).
# Se vazio, as solicitações ficam pendentes no banco local, sem aviso à equipe.
TEAM_CHAT_ID=

# Opcional: um grupo diferente para cada setor; substitui o grupo padrão.
SUPORTE_CHAT_ID=
FINANCEIRO_CHAT_ID=
